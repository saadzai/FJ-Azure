# ─── Database (PostgreSQL Connection) ──────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=fashion_jewellery_db
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ─── Server Configuration ─────────────────────────────────
PORT=5000
FRONTEND_ORIGINS=http://localhost:5173

# ─── Authentication Configuration ─────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# ─── Static Administrative Credentials ─────────────────────
# These environment variables configure the direct master admin user
ADMIN_EMAIL=admin@jewellery.com
ADMIN_PASSWORD_HASH=
ADMIN_NAME=System Admin

# ─── Local n8n Webhook Integration ────────────────────────
N8N_INSTAGRAM_WEBHOOK_URL=http://localhost:5678/webhook/social-media-product-post
N8N_WEBHOOK_SECRET=

# ─── Cloudinary Image Storage Configuration ───────────────
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# ─── Groq AI Configuration ────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

